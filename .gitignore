tt.*
.tests
doc/tags
debug
.repro
foo.*
*.log
data

# NOTE: lazy-lock.json and lazyvim.json MUST stay tracked — they are what
# makes a fresh clone reproduce the exact plugin set and LazyVim extras.
# Do not re-add them here.

# Swap/backup/undo files (if you have them)
*.swp
*.swo
*~

# System-specific files (like netrwhist)
.netrwhist

# If you use Neovim’s built-in packages
pack/

# Any local testing files
test/
/.freebuff

# Runtime state and build artifacts. These normally live in stdpath("state")
# and stdpath("data"), but ignore them here so a stray runtime path can never
# push them into the repo.
shada/
swap/
undo/
*.so
*.dll
*.pdb
